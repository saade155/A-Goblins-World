; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="This Goblin's World"
config/description="A 2D side-view mining game about a goblin exploring an underground world."
run/main_scene="res://scenes/menus/title_screen.tscn"
config/features=PackedStringArray("4.5")

[autoload]

GameServer="*res://scripts/autoloads/game_server.gd"
GameState="*res://scripts/autoloads/game_state.gd"
InputManager="*res://scripts/autoloads/input_manager.gd"
BehaviorTracker="*res://scripts/autoloads/behavior_tracker.gd"
TileDatabase="*res://scripts/data/tile_data.gd"
ItemDatabase="*res://scripts/data/item_data.gd"
ExplorationTracker="*res://scripts/world/exploration_tracker.gd"
SettingsManager="*res://scripts/autoloads/settings_manager.gd"
SkillSystem="*res://scripts/autoloads/skill_system.gd"
DebugConsole="*res://scripts/autoloads/debug_console.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="This Goblin-s World"

